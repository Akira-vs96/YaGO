# Copy to .env for a local Compose installation and change the password.
POSTGRES_PASSWORD=replace-with-a-long-local-password
YAGO_DB_PORT=55433
YAGO_API_PORT=8008
YAGO_WEB_PORT=8088
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
COOKIE_SECURE=0
DEMO_MODE=1
NOMINATIM_USER_AGENT=YaGo/1.0 (contact: your-email@example.com)
# Set to 1 only after taking a pg_dump before upgrading a populated database.
BACKUP_CONFIRMED=0
