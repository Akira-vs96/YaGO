        <mxCell id="p-rent3" value="Сапарды аяқтау,&lt;br&gt;тұрақ аймағын және&lt;br&gt;құлыпты тексеру" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172b4d;strokeWidth=2;fontSize=14;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1390" y="570" width="220" height="120" as="geometry" /></mxCell>
