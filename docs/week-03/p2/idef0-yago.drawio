        <mxCell id="i-actors" value="Ақпарат көздері&lt;br&gt;&lt;br&gt;Клиент&lt;br&gt;Жүргізуші / курьер&lt;br&gt;Мейрамхана&lt;br&gt;Оператор / әкімші" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#52606d;strokeWidth=2;fontSize=16;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="260" width="250" height="270" as="geometry" /></mxCell>
        <mxCell id="i-ui" value="Клиенттік веб-қосымша&lt;br&gt;React / Leaflet&lt;br&gt;&lt;br&gt;Сұранымдар, карта және&lt;br&gt;мәртебе хабарламалары" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172b4d;strokeWidth=2;fontSize=16;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="270" height="190" as="geometry" /></mxCell>
        <mxCell id="i-api" value="FastAPI жүйе модульдері&lt;br&gt;&lt;br&gt;Қолжетімділікті басқару · Тапсырыс&lt;br&gt;Карта · Жалға алу · Әкімшілік&lt;br&gt;&lt;br&gt;REST және WebSocket" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172b4d;strokeWidth=2;fontSize=16;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="965" y="265" width="300" height="260" as="geometry" /></mxCell>
        <mxCell id="i-data" value="PostgreSQL / PostGIS деректері&lt;br&gt;&lt;br&gt;Пайдаланушылар, рөлдер, сессиялар&lt;br&gt;Тапсырыстар, мейрамханалар, мәзір&lt;br&gt;Орындаушылар, техника, геоқоршаулар&lt;br&gt;Жалдау, тарифтер, тапсырыс тарихы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#52606d;strokeWidth=2;fontSize=15;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1460" y="245" width="300" height="300" as="geometry" /></mxCell>
        <mxCell id="i-external" value="Сыртқы және эмуляцияланатын қызметтер&lt;br&gt;&lt;br&gt;OSRM бағыттау қызметі&lt;br&gt;Құлып эмуляторы және телеметрия" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#9a5b13;strokeWidth=2;fontSize=15;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="650" width="330" height="130" as="geometry" /></mxCell>
        <mxCell id="i-flow1" value="Пайдаланушы деректері&lt;br&gt;мен әрекеттері" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=13;fontColor=#172b4d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="i-actors" target="i-ui"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-24" as="offset" /></mxGeometry></mxCell>
        <mxCell id="i-flow2" value="REST сұранымдары&lt;br&gt;және картадағы таңдау" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=13;fontColor=#172b4d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="i-ui" target="i-api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-24" as="offset" /></mxGeometry></mxCell>
        <mxCell id="i-flow3" value="Тексерілген деректерді&lt;br&gt;оқу / сақтау" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=13;fontColor=#172b4d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="i-api" target="i-data"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-24" as="offset" /></mxGeometry></mxCell>
        <mxCell id="i-flow4" value="Бағыт сұранымы, құлып командасы&lt;br&gt;және телеметрия жауабы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9a5b13;fontSize=12;fontColor=#172b4d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="i-external" target="i-api"><mxGeometry relative="1" as="geometry"><mxPoint x="-190" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="i-flow5" value="Мәртебе мен орын&lt;br&gt;деректерін тарату" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=12;fontColor=#172b4d;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitPerimeter=0;entryX=1;entryY=0.75;entryPerimeter=0;" edge="1" parent="1" source="i-api" target="i-ui"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-24" as="offset" /></mxGeometry></mxCell>
        <mxCell id="i-foot" value="Деректердің тұрақты көзі — серверлік база; браузер PostgreSQL-ге тікелей қосылмайды." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#52606d;" vertex="1" parent="1"><mxGeometry x="55" y="825" width="1100" height="25" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="idef2-dynamic" name="IDEF2 динамикалық модель">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="s-title" value="IDEF2 · Қызмет көрсету динамикасының тұжырымдамалық моделі" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1100" height="40" as="geometry" /></mxCell>
        <mxCell id="s-subtitle" value="Сұранымдардың келуі, кезек, орындаушы ресурстары және қызмет ұзақтығы" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#52606d;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="s-input" value="Клиент сұранымдары&lt;br&gt;&lt;br&gt;Келу қарқыны: λ&lt;br&gt;Қызмет түрі және нүктелер" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#52606d;strokeWidth=2;fontSize=15;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="210" height="150" as="geometry" /></mxCell>
        <mxCell id="s-validate" value="Тексеру және тапсырысты құру&lt;br&gt;&lt;br&gt;Қолжетімділікті тексеру / тапсырыс модулі&lt;br&gt;Өңдеу уақыты: T₁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172b4d;strokeWidth=2;fontSize=15;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="230" height="150" as="geometry" /></mxCell>
        <mxCell id="s-queue" value="Орындаушыны немесе техниканы күту&lt;br&gt;&lt;br&gt;Кезек ұзындығы: Q&lt;br&gt;Қолжетімді ресурстар саны: c" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#9a5b13;strokeWidth=2;fontSize=15;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="250" height="210" as="geometry" /></mxCell>
        <mxCell id="s-service" value="Қызметті орындау&lt;br&gt;&lt;br&gt;Такси / жеткізу немесе жалдау&lt;br&gt;Ұзақтығы: T₂&lt;br&gt;Маршрут және бос емес уақыт" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172b4d;strokeWidth=2;fontSize=15;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="330" width="240" height="150" as="geometry" /></mxCell>
        <mxCell id="s-finish" value="Аяқтау және деректерді сақтау&lt;br&gt;&lt;br&gt;Мәртебе, соңғы құн, тарих&lt;br&gt;WebSocket хабарламасы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#52606d;strokeWidth=2;fontSize=15;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="330" width="210" height="150" as="geometry" /></mxCell>
        <mxCell id="s-flow1" value="Жарамды&lt;br&gt;сұранымдар" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=12;fontColor=#172b4d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s-input" target="s-validate"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry></mxCell>
        <mxCell id="s-flow2" value="Құрылған&lt;br&gt;тапсырыс" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=12;fontColor=#172b4d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s-validate" target="s-queue"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry></mxCell>
        <mxCell id="s-flow3" value="Ресурс бөлінген&lt;br&gt;тапсырыс" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=12;fontColor=#172b4d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s-queue" target="s-service"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry></mxCell>
        <mxCell id="s-flow4" value="Орындалған&lt;br&gt;қызмет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=12;fontColor=#172b4d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s-service" target="s-finish"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry></mxCell>
        <mxCell id="s-parameters" value="Модель параметрлері: λ — сұранымдардың келу қарқыны; T₁ — тексеру уақыты; T₂ — қызмет ұзақтығы; c — қолжетімді ресурс саны. OSRM бағыт ұзақтығына әсер етеді; WebSocket мәртебе өзгерісін таратады." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=14;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="240" y="610" width="1030" height="115" as="geometry" /></mxCell>
        <mxCell id="s-output" value="Зерттелетін көрсеткіштер: күту уақыты · кезектің ең үлкен ұзындығы · орындаушы / техника жүктемесі · қызмет көрсетуден бас тарту үлесі" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="240" y="755" width="1120" height="55" as="geometry" /></mxCell>
        <mxCell id="s-foot" value="Тұжырымдамалық модель: T₁, T₂, λ және c нақты деректермен өлшеніп, модель калибрленгенге дейін сандық нәтиже болып саналмайды." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#52606d;" vertex="1" parent="1"><mxGeometry x="50" y="840" width="1300" height="25" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
