        <mxCell id="p-taxi2" value="Жүргізушіні / курьерді&lt;br&gt;тағайындау" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172b4d;strokeWidth=2;fontSize=14;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="280" width="210" height="110" as="geometry" /></mxCell>
        <mxCell id="p-taxi3" value="Қызметті орындау&lt;br&gt;және мәртебені жаңарту" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172b4d;strokeWidth=2;fontSize=14;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1390" y="280" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="p-rent1" value="QR-код пен техниканың&lt;br&gt;қолжетімділігін тексеру,&lt;br&gt;бронь жасау" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172b4d;strokeWidth=2;fontSize=14;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="570" width="220" height="120" as="geometry" /></mxCell>
