        <mxCell id="p-save" value="Нәтижені, соңғы құнды&lt;br&gt;және тарихты сақтау" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#172b4d;strokeWidth=2;fontSize=14;fontColor=#172b4d;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1760" y="395" width="220" height="120" as="geometry" /></mxCell>
